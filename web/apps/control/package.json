  "name": "@tasklattice/control",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:generate-seed": "tsx prisma/generate-seed-migration.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:seed-skills": "node prisma/seed-built-in-skills.mjs",
    "prebuild": "npm run db:generate",
    "build": "vite build",
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/vite/bin/vite.js",
    "start": "node .output/server/index.mjs",
    "pretest": "npm run db:generate",
    "test": "vitest run --config vitest.config.ts",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
